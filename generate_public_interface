#!/bin/bash
# Backward-compatibility wrapper for the old generate_public_interface script.
# Delegates to `alignment interface`.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
BIN="$SCRIPT_DIR/.build/debug/alignment"

# Build if needed
if [ ! -x "$BIN" ]; then
    (cd "$SCRIPT_DIR" && swift build -q) || exit 1
fi

exec "$BIN" interface "$@"
